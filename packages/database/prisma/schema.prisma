generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" is Vercel's serverless runtime (Amazon Linux 2).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryRecord {
  id           String                @id
  businessId   String
  tenantId     String
  variantId    String
  warehouseId  String
  version      Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  createdBy    String
  updatedBy    String
  deletedBy    String?
  variant      ProductVariant        @relation(fields: [variantId], references: [id])
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id])
  reservations ReservationRecord[]
  movements    StockMovementRecord[]

  @@unique([businessId, variantId, warehouseId])
  @@index([businessId, variantId, warehouseId])
  @@map("inventory")
}

model StockMovementRecord {
  id            String          @id
  businessId    String
  tenantId      String
  inventoryId   String
  variantId     String
  warehouseId   String
  batchId       String?
  type          String
  quantityValue Float
  quantityUnit  String
  actorId       String
  correlationId String?
  causationId   String?
  metadata      Json?
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())
  inventory     InventoryRecord @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId, occurredAt])
  @@index([businessId, batchId])
  @@map("stock_movements")
}

model BatchRecord {
  id         String    @id
  businessId String
  tenantId   String
  variantId  String
  code       String
  status     String
  expiresAt  DateTime?
  version    Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String
  updatedBy  String

  @@unique([businessId, variantId, code])
  @@map("batches")
}

model ReservationRecord {
  id          String          @id
  businessId  String
  tenantId    String
  inventoryId String
  quantity    Float
  referenceId String
  expiresAt   DateTime
  status      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inventory   InventoryRecord @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId, expiresAt])
  @@map("reservations")
}

model OutboxEventRecord {
  eventId          String    @id
  eventType        String
  aggregateId      String
  aggregateVersion Int
  correlationId    String?
  causationId      String?
  businessId       String
  tenantId         String
  occurredAt       DateTime
  payload          Json
  retryCount       Int       @default(0)
  status           String
  processedAt      DateTime?
  lastAttemptAt    DateTime?
  failureReason    String?
  createdAt        DateTime  @default(now())

  @@index([status, occurredAt, retryCount])
  @@map("outbox_events")
}

model Tenant {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
  roles      Role[]
  users      User[]

  @@map("tenants")
}

model BusinessType {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  businesses  Business[]

  @@map("business_types")
}

model Business {
  id                   String                      @id @default(cuid())
  tenantId             String
  businessTypeId       String
  name                 String
  slug                 String                      @unique
  status               String                      @default("ACTIVE")
  defaultCurrencyId    String?
  fiscalYearStartMonth Int                         @default(4)
  legalName            String?
  tagline              String?
  logoUrl              String?
  primaryColor         String?
  accentColor          String?
  email                String?
  phone                String?
  addressLine          String?
  taxId                String?
  footerNote           String?
  paymentInstructions  String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  bankAccounts         BankAccount[]
  accountingPeriods    AccountingPeriod[]
  businessType         BusinessType                @relation(fields: [businessTypeId], references: [id])
  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashTransactions     CashTransaction[]
  customerInvoices     CustomerInvoice[]
  customerAllocations  CustomerPaymentAllocation[]
  customerPayments     CustomerPayment[]
  deliveryRunStops     DeliveryRunStop[]
  deliveryRuns         DeliveryRun[]
  drivers              Driver[]
  ewayBills            EWayBill[]
  financialPeriods     FinancialPeriod[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  accounts             LedgerAccount[]
  memberships          Membership[]
  payableEntries       PayableEntry[]
  paymentAllocations   PaymentAllocation[]
  receivableEntries    ReceivableEntry[]
  recurringCommitments RecurringCommitment[]
  supplierBills        SupplierBill[]
  supplierPayments     SupplierPayment[]
  transporters         Transporter[]
  vehicles             Vehicle[]

  @@index([tenantId])
  @@map("businesses")
}

model User {
  id            String       @id @default(cuid())
  tenantId      String
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  memberships   Membership[]
  sessions      Session[]
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  memberships Membership[]
  permissions RolePermission[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("memberships")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  businessId String?
  actorId    String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([businessId, occurredAt])
  @@map("audit_logs")
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  businessId  String
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([businessId, name])
  @@map("expense_categories")
}

model ManufacturingBatch {
  id               String   @id @default(cuid())
  businessId       String
  tenantId         String
  productId        String
  fillingPartnerId String?
  batchNumber      String
  status           String
  quantity         Float
  createdAt        DateTime @default(now())

  @@unique([businessId, batchNumber])
  @@map("manufacturing_batches")
}

model DashboardProjection {
  businessId        String   @id
  tenantId          String
  totalProducts     Int      @default(0)
  totalStockValue   Float    @default(0.0)
  lowStockCount     Int      @default(0)
  warehouseCount    Int      @default(0)
  reservedQuantity  Float    @default(0.0)
  projectionVersion Int      @default(1)
  sourceEventVer    Int      @default(0)
  rebuiltAt         DateTime @default(now())

  @@map("inventory_dashboard_projection")
}

model MovementTimelineProjection {
  movementId        String   @id
  businessId        String
  tenantId          String
  inventoryId       String
  timestamp         DateTime
  actor             String
  type              String
  quantity          Float
  unit              String
  warehouse         String
  batch             String?
  projectionVersion Int      @default(1)
  sourceEventVer    Int      @default(0)
  rebuiltAt         DateTime @default(now())

  @@index([businessId, timestamp(sort: Desc)])
  @@index([inventoryId, timestamp(sort: Desc)])
  @@map("movement_timeline_projection")
}

model InventoryVariantProjection {
  id                String   @id @default(cuid())
  businessId        String
  tenantId          String
  variantId         String
  warehouseId       String
  onHandQuantity    Float    @default(0.0)
  reservedQuantity  Float    @default(0.0)
  availableQuantity Float    @default(0.0)
  averageCost       Decimal  @default(0.0)
  rebuiltAt         DateTime @default(now())

  @@unique([businessId, variantId, warehouseId])
  @@index([businessId, variantId])
  @@map("inventory_variant_projection")
}

model Unit {
  id         String           @id @default(cuid())
  businessId String
  name       String
  symbol     String
  isSystem   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  variants   ProductVariant[]

  @@unique([businessId, symbol])
  @@map("units")
}

model Category {
  id         String     @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]

  @@index([businessId])
  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  type        ProductType      @default(PHYSICAL)
  status      ProductStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  variants    ProductVariant[]
  category    Category?        @relation(fields: [categoryId], references: [id])

  @@index([businessId])
  @@map("products")
}

model ProductVariant {
  id               String            @id @default(cuid())
  businessId       String
  productId        String
  sku              String?           @unique
  name             String
  unitId           String
  price            Float             @default(0.0)
  cost             Float             @default(0.0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  inventory        InventoryRecord[]
  unit             Unit              @relation(fields: [unitId], references: [id])
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines   QuotationLine[]
  salesOrderLines  SalesOrderLine[]
  salesReturnLines SalesReturnLine[]
  shipmentLines    ShipmentLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceiptLines        GoodsReceiptLine[]
  purchaseRequisitionLines PurchaseRequisitionLine[]

  @@index([businessId])
  @@map("product_variants")
}

model Warehouse {
  id            String            @id @default(cuid())
  businessId    String
  code          String
  name          String
  warehouseType WarehouseType     @default(STORAGE)
  location      String?
  isActive      Boolean           @default(true)
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  inventory     InventoryRecord[]
  shipments     Shipment[]

  @@unique([businessId, code])
  @@map("warehouses")
}

model Currency {
  id               String            @id @default(cuid())
  businessId       String
  code             String            @unique
  name             String
  symbol           String
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  cashTransactions CashTransaction[]
  customerInvoices CustomerInvoice[]
  customerPayments CustomerPayment[]
  purchaseOrders   PurchaseOrder[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]

  @@map("currencies")
}

model Supplier {
  id               String            @id @default(cuid())
  businessId       String
  name             String
  code             String
  status           SupplierStatus    @default(PROSPECT)
  riskLevel        SupplierRiskLevel @default(LOW)
  paymentTerms     String?
  paymentTermsDays Int?
  creditLimit      Decimal?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  purchaseOrders   PurchaseOrder[]
  supplierBills    SupplierBill[]
  contacts         SupplierContact[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_contacts")
}

model PurchaseRequisition {
  id            String                    @id @default(cuid())
  businessId    String
  code          String
  status        PRStatus                  @default(DRAFT)
  requesterId   String
  department    String?
  justification String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lines         PurchaseRequisitionLine[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id            String              @id @default(cuid())
  prId          String
  variantId     String
  quantity      Float
  estimatedCost Float?
  requisition   PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  variant       ProductVariant      @relation(fields: [variantId], references: [id])

  @@map("purchase_requisition_lines")
}

model PurchaseOrder {
  id          String                @id @default(cuid())
  businessId  String
  code        String
  supplierId  String
  status      POStatus              @default(DRAFT)
  orderedAt   DateTime?
  expectedAt  DateTime?
  totalAmount Float                 @default(0.0)
  currencyId  String
  approvedBy  String?
  approvedAt  DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  receipts    GoodsReceiptRequest[]
  lines       PurchaseOrderLine[]
  currency    Currency              @relation(fields: [currencyId], references: [id])
  supplier    Supplier              @relation(fields: [supplierId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  variantId     String
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  receivedQty   Float         @default(0.0)
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_order_lines")
}

model GoodsReceiptRequest {
  id            String                    @id @default(cuid())
  businessId    String
  code          String
  poId          String
  warehouseId   String
  status        GoodsReceiptRequestStatus @default(REQUESTED)
  receivedAt    DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lines         GoodsReceiptLine[]
  purchaseOrder PurchaseOrder             @relation(fields: [poId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("goods_receipt_requests")
}

model GoodsReceiptLine {
  id           String              @id @default(cuid())
  grId         String
  poLineId     String
  variantId    String
  requestedQty Float
  acceptedQty  Float               @default(0.0)
  rejectedQty  Float               @default(0.0)
  varianceQty  Float               @default(0.0)
  goodsReceipt GoodsReceiptRequest @relation(fields: [grId], references: [id], onDelete: Cascade)
  variant      ProductVariant      @relation(fields: [variantId], references: [id])

  @@map("goods_receipt_lines")
}

model ExecutiveDashboardProjection {
  id                String   @id @default(cuid())
  businessId        String   @unique
  totalInventoryVal Float    @default(0.0)
  openPOAmount      Float    @default(0.0)
  monthlySpend      Float    @default(0.0)
  activeSuppliers   Int      @default(0)
  pendingReceipts   Int      @default(0)
  lowStockAlerts    Int      @default(0)
  snapshotDate      DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("reporting_executive_dashboard")
}

model InventoryReportProjection {
  id               String    @id @default(cuid())
  businessId       String
  warehouseId      String
  variantId        String
  onHand           Float     @default(0.0)
  reserved         Float     @default(0.0)
  available        Float     @default(0.0)
  totalValue       Float     @default(0.0)
  averageCost      Float     @default(0.0)
  lastMovementDate DateTime?

  @@unique([businessId, warehouseId, variantId])
  @@index([businessId])
  @@map("reporting_inventory_snapshot")
}

model ProcurementReportProjection {
  id                String @id @default(cuid())
  businessId        String
  supplierId        String
  totalSpendYTD     Float  @default(0.0)
  openOrderCount    Int    @default(0)
  lateDeliveryCount Int    @default(0)
  receiptVariance   Float  @default(0.0)

  @@unique([businessId, supplierId])
  @@index([businessId])
  @@map("reporting_procurement_snapshot")
}

model SupplierPerformanceProjection {
  id              String @id @default(cuid())
  businessId      String
  supplierId      String @unique
  onTimePercent   Float  @default(100.0)
  variancePercent Float  @default(0.0)
  openOrders      Int    @default(0)
  avgLeadTimeDays Float  @default(0.0)

  @@index([businessId])
  @@map("reporting_supplier_performance")
}

model Customer {
  id                String               @id @default(cuid())
  businessId        String
  code              String
  name              String
  status            CustomerStatus       @default(ACTIVE)
  creditStatus      CustomerCreditStatus @default(GOOD)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  addresses         CustomerAddress[]
  contacts          CustomerContact[]
  customerInvoices  CustomerInvoice[]
  customerPayments  CustomerPayment[]
  quotations        Quotation[]
  receivableEntries ReceivableEntry[]
  salesOrders       SalesOrder[]
  returns           SalesReturn[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  label       String
  addressLine String
  city        String?
  state       String?
  country     String?
  zipCode     String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Quotation {
  id          String          @id @default(cuid())
  businessId  String
  code        String
  customerId  String
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  expiredAt   DateTime?
  totalAmount Float           @default(0.0)
  currencyId  String
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       QuotationLine[]
  currency    Currency        @relation(fields: [currencyId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("quotations")
}

model QuotationLine {
  id          String         @id @default(cuid())
  quotationId String
  variantId   String
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_lines")
}

model SalesOrder {
  id          String           @id @default(cuid())
  businessId  String
  code        String
  customerId  String
  status      SalesOrderStatus @default(DRAFT)
  totalAmount Float            @default(0.0)
  currencyId  String
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lines       SalesOrderLine[]
  currency    Currency         @relation(fields: [currencyId], references: [id])
  customer    Customer         @relation(fields: [customerId], references: [id])
  returns     SalesReturn[]
  shipments   Shipment[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String         @id @default(cuid())
  soId          String
  variantId     String
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  fulfilledQty  Float          @default(0.0)
  reservedQty   Float          @default(0.0)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  salesOrder    SalesOrder     @relation(fields: [soId], references: [id], onDelete: Cascade)
  shipmentLines ShipmentLine[]

  @@map("sales_order_lines")
}

model SalesReturn {
  id          String            @id @default(cuid())
  businessId  String
  code        String
  customerId  String
  soId        String
  warehouseId String?
  status      SalesReturnStatus @default(REQUESTED)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       SalesReturnLine[]
  salesOrder  SalesOrder        @relation(fields: [soId], references: [id])
  customer    Customer          @relation(fields: [customerId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("sales_returns")
}

model SalesReturnLine {
  id          String         @id @default(cuid())
  returnId    String
  soLineId    String
  variantId   String
  quantity    Float
  reason      String?
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  salesReturn SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("sales_return_lines")
}

model SalesReportProjection {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String
  totalSales      Float    @default(0.0)
  openOrders      Int      @default(0)
  fulfilledOrders Int      @default(0)
  returnCount     Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([businessId, customerId])
  @@index([businessId])
  @@map("reporting_sales_snapshot")
}

model Shipment {
  id                 String           @id @default(cuid())
  businessId         String
  code               String
  soId               String
  warehouseId        String
  status             ShipmentStatus   @default(DRAFT)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  deliveryRunStopId  String?
  weightKg           Decimal?
  caseCount          Decimal?
  volume             Decimal?
  proofOfDeliveryUrl String?
  receivedBy         String?
  receivedAt         DateTime?
  receiverPhone      String?
  deliveryNote       DeliveryNote?
  lines              ShipmentLine[]
  deliveryRunStop    DeliveryRunStop? @relation(fields: [deliveryRunStopId], references: [id])
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id])
  salesOrder         SalesOrder       @relation(fields: [soId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("shipments")
}

model ShipmentLine {
  id             String         @id @default(cuid())
  shipmentId     String
  soLineId       String
  variantId      String
  requestedQty   Float
  pickedQty      Float          @default(0.0)
  packedQty      Float          @default(0.0)
  shippedQty     Float          @default(0.0)
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  salesOrderLine SalesOrderLine @relation(fields: [soLineId], references: [id])
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("shipment_lines")
}

model DeliveryNote {
  id                String    @id @default(cuid())
  shipmentId        String    @unique
  code              String
  deliveryDate      DateTime?
  receiverName      String?
  receiverSignature String?
  remarks           String?
  createdAt         DateTime  @default(now())
  shipment          Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("delivery_notes")
}

model CustomerInvoice {
  id               String                  @id @default(cuid())
  businessId       String
  code             String
  customerId       String
  currencyId       String
  totalAmount      Decimal
  paidAmount       Decimal                 @default(0.0)
  remainingAmount  Decimal
  status           InvoiceStatus           @default(ISSUED)
  collectionStatus InvoiceCollectionStatus @default(CURRENT)
  sourceType       FinanceSourceType
  sourceId         String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  lines            CustomerInvoiceLine[]
  business         Business                @relation(fields: [businessId], references: [id])
  currency         Currency                @relation(fields: [currencyId], references: [id])
  customer         Customer                @relation(fields: [customerId], references: [id])
  payments         CustomerPayment[]
  ewayBills        EWayBill[]

  @@unique([businessId, code])
  @@unique([sourceType, sourceId])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id           String          @id @default(cuid())
  invoiceId    String
  description  String
  quantity     Decimal
  unitPrice    Decimal
  totalPrice   Decimal
  costCenterId String?
  costCenter   CostCenter?     @relation(fields: [costCenterId], references: [id])
  invoice      CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("customer_invoice_lines")
}

model CustomerPayment {
  id                String                      @id @default(cuid())
  businessId        String
  customerId        String?
  invoiceId         String?
  amount            Decimal
  unallocatedAmount Decimal                     @default(0.0)
  currencyId        String
  paymentDate       DateTime                    @default(now())
  reference         String?
  createdBy         String?
  method            PaymentMethod               @default(BANK_TRANSFER)
  allocations       CustomerPaymentAllocation[]
  business          Business                    @relation(fields: [businessId], references: [id])
  currency          Currency                    @relation(fields: [currencyId], references: [id])
  invoice           CustomerInvoice?            @relation(fields: [invoiceId], references: [id])
  customer          Customer?                   @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([invoiceId])
  @@map("customer_payments")
}

model ReceivableEntry {
  id             String                      @id @default(cuid())
  businessId     String
  customerId     String?
  sourceType     ReceivableSourceType
  sourceId       String
  amount         Decimal
  paidAmount     Decimal                     @default(0.0)
  dueDate        DateTime?
  status         ReceivableStatus            @default(OPEN)
  journalEntryId String?
  allocations    CustomerPaymentAllocation[]
  customer       Customer?                   @relation(fields: [customerId], references: [id])
  business       Business                    @relation(fields: [businessId], references: [id])

  @@unique([sourceType, sourceId])
  @@index([businessId])
  @@index([status])
  @@index([dueDate])
  @@index([customerId])
  @@map("receivable_entries")
}

model CustomerPaymentAllocation {
  id                String          @id @default(cuid())
  businessId        String
  paymentId         String
  receivableEntryId String
  amount            Decimal
  business          Business        @relation(fields: [businessId], references: [id])
  receivableEntry   ReceivableEntry @relation(fields: [receivableEntryId], references: [id], onDelete: Cascade)
  payment           CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, receivableEntryId])
  @@index([businessId])
  @@map("customer_payment_allocations")
}

model SupplierBill {
  id              String             @id @default(cuid())
  businessId      String
  code            String
  supplierId      String
  currencyId      String
  totalAmount     Decimal
  paidAmount      Decimal            @default(0.0)
  remainingAmount Decimal
  status          SupplierBillStatus @default(DRAFT)
  sourceType      FinanceSourceType
  sourceId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  lines           SupplierBillLine[]
  business        Business           @relation(fields: [businessId], references: [id])
  currency        Currency           @relation(fields: [currencyId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  payments        SupplierPayment[]

  @@unique([businessId, code])
  @@unique([sourceType, sourceId])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id           String        @id @default(cuid())
  billId       String
  description  String
  quantity     Decimal
  unitPrice    Decimal
  totalPrice   Decimal
  accountId    String
  costCenterId String?
  costCenter   CostCenter?   @relation(fields: [costCenterId], references: [id])
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  bill         SupplierBill  @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("supplier_bill_lines")
}

model SupplierPayment {
  id          String              @id @default(cuid())
  businessId  String
  billId      String?
  amount      Decimal
  currencyId  String
  paymentDate DateTime            @default(now())
  reference   String?
  createdBy   String?
  method      PaymentMethod       @default(BANK_TRANSFER)
  allocations PaymentAllocation[]
  business    Business            @relation(fields: [businessId], references: [id])
  currency    Currency            @relation(fields: [currencyId], references: [id])
  bill        SupplierBill?       @relation(fields: [billId], references: [id])

  @@index([businessId])
  @@index([billId])
  @@map("supplier_payments")
}

model PayableEntry {
  id             String              @id @default(cuid())
  businessId     String
  sourceType     PayableSourceType
  sourceId       String
  amount         Decimal
  paidAmount     Decimal             @default(0.0)
  dueDate        DateTime?
  status         PayableStatus       @default(OPEN)
  journalEntryId String?
  business       Business            @relation(fields: [businessId], references: [id])
  allocations    PaymentAllocation[]

  @@unique([sourceType, sourceId])
  @@index([businessId])
  @@index([status])
  @@index([dueDate])
  @@map("payable_entries")
}

model PaymentAllocation {
  id             String          @id @default(cuid())
  businessId     String
  paymentId      String
  payableEntryId String
  amount         Decimal
  business       Business        @relation(fields: [businessId], references: [id])
  payableEntry   PayableEntry    @relation(fields: [payableEntryId], references: [id], onDelete: Cascade)
  payment        SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, payableEntryId])
  @@index([businessId])
  @@map("payment_allocations")
}

model CashTransaction {
  id          String              @id @default(cuid())
  businessId  String
  type        CashTransactionType
  amount      Decimal
  currencyId  String
  reference   String?
  description String?
  sourceType  FinanceSourceType?
  sourceId    String?
  occurredAt  DateTime            @default(now())
  createdBy   String?
  business    Business            @relation(fields: [businessId], references: [id])
  currency    Currency            @relation(fields: [currencyId], references: [id])

  @@index([businessId])
  @@map("cash_transactions")
}

model AccountingPeriod {
  id         String       @id @default(cuid())
  businessId String
  name       String
  startDate  DateTime
  endDate    DateTime
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedBy   String?
  lockedAt   DateTime?
  lockedBy   String?
  business   Business     @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
  @@map("accounting_periods")
}

model LedgerAccount {
  id                String             @id @default(cuid())
  businessId        String
  accountCode       String
  name              String
  accountType       AccountTypeEnum
  normalBalance     NormalBalance      @default(DEBIT)
  isControlAccount  Boolean            @default(false)
  isSystem          Boolean            @default(false)
  allowPosting      Boolean            @default(true)
  parentAccountId   String?
  journalLines      JournalLine[]
  parentAccount     LedgerAccount?     @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts     LedgerAccount[]    @relation("AccountHierarchy")
  business          Business           @relation(fields: [businessId], references: [id])
  supplierBillLines SupplierBillLine[]

  @@unique([businessId, accountCode])
  @@index([businessId])
  @@map("ledger_accounts")
}

model FinancialPeriod {
  id         String                @id @default(cuid())
  businessId String
  name       String
  startDate  DateTime
  endDate    DateTime
  status     FinancialPeriodStatus @default(OPEN)
  closedBy   String?
  closedAt   DateTime?
  business   Business              @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId, startDate, endDate])
  @@index([status])
  @@map("financial_periods")
}

model JournalEntry {
  id          String            @id @default(cuid())
  businessId  String
  date        DateTime          @default(now())
  description String
  reference   String?
  sourceType  JournalSourceType
  sourceId    String?
  reason      String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    Business          @relation(fields: [businessId], references: [id])
  lines       JournalLine[]

  @@index([businessId])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(cuid())
  businessId     String
  journalEntryId String
  accountId      String
  debit          Decimal       @default(0.0)
  credit         Decimal       @default(0.0)
  costCenterId   String?
  costCenter     CostCenter?   @relation(fields: [costCenterId], references: [id])
  business       Business      @relation(fields: [businessId], references: [id])
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Transporter {
  id          String        @id @default(cuid())
  businessId  String
  code        String
  name        String
  gstin       String?
  contactName String?
  phone       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        DeliveryRun[]
  drivers     Driver[]
  business    Business      @relation(fields: [businessId], references: [id])
  vehicles    Vehicle[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("transporters")
}

model Vehicle {
  id             String        @id @default(cuid())
  businessId     String
  transporterId  String
  registration   String
  type           String?
  capacityKg     Decimal?
  capacityCases  Decimal?
  capacityVolume Decimal?
  runs           DeliveryRun[]
  drivers        Driver[]
  business       Business      @relation(fields: [businessId], references: [id])
  transporter    Transporter   @relation(fields: [transporterId], references: [id])

  @@unique([businessId, registration])
  @@index([transporterId])
  @@index([businessId])
  @@map("vehicles")
}

model Driver {
  id                String        @id @default(cuid())
  businessId        String
  name              String
  phone             String?
  licenseNumber     String?
  licenseExpiry     DateTime?
  identityType      String?
  identityReference String?
  isExternal        Boolean       @default(false)
  transporterId     String?
  defaultVehicleId  String?
  runs              DeliveryRun[]
  business          Business      @relation(fields: [businessId], references: [id])
  defaultVehicle    Vehicle?      @relation(fields: [defaultVehicleId], references: [id])
  transporter       Transporter?  @relation(fields: [transporterId], references: [id])

  @@index([businessId])
  @@map("drivers")
}

model DeliveryRun {
  id            String            @id @default(cuid())
  businessId    String
  code          String
  transporterId String
  vehicleId     String
  driverId      String?
  status        DeliveryRunStatus @default(SCHEDULED)
  dispatchDate  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  stops         DeliveryRunStop[]
  business      Business          @relation(fields: [businessId], references: [id])
  driver        Driver?           @relation(fields: [driverId], references: [id])
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  transporter   Transporter       @relation(fields: [transporterId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("delivery_runs")
}

model DeliveryRunStop {
  id              String                @id @default(cuid())
  businessId      String
  deliveryRunId   String
  stopSequence    Int
  locationName    String?
  customerId      String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  latitude        Decimal?
  longitude       Decimal?
  expectedArrival DateTime?
  actualArrival   DateTime?
  status          DeliveryRunStopStatus @default(PENDING)
  business        Business              @relation(fields: [businessId], references: [id])
  deliveryRun     DeliveryRun           @relation(fields: [deliveryRunId], references: [id])
  shipments       Shipment[]

  @@index([deliveryRunId])
  @@index([businessId])
  @@map("delivery_run_stops")
}

model EInvoice {
  id                 String         @id @default(cuid())
  customerInvoiceId  String
  irn                String?
  ackNumber          String?
  ackDate            DateTime?
  status             EInvoiceStatus
  generationAttempts Int            @default(0)
  lastError          String?
  createdAt          DateTime       @default(now())
}

model EWayBill {
  id                 String                   @id @default(cuid())
  businessId         String
  ewbNumber          String                   @unique
  invoiceId          String
  shipmentId         String?
  generationSource   EWayBillGenerationSource @default(MANUAL)
  status             EWayBillStatus           @default(DRAFT)
  generationAttempts Int                      @default(0)
  lastError          String?
  validFrom          DateTime?
  validUntil         DateTime?
  generatedBy        String?
  vehicleNumber      String?
  transporterName    String?
  cancelledAt        DateTime?
  cancelReason       String?
  remarks            String?
  vehicleId          String?
  transporterId      String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  invoice            CustomerInvoice          @relation(fields: [invoiceId], references: [id])
  business           Business                 @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("eway_bills")
}

model BankAccount {
  id              String                      @id @default(cuid())
  businessId      String
  name            String
  accountNumber   String
  ifscCode        String?
  openingBalance  Decimal                     @default(0)
  currencyId      String?
  status          String                      @default("ACTIVE")
  ledgerAccountId String                      @unique
  business        Business                    @relation(fields: [businessId], references: [id])
  sessions        BankReconciliationSession[]
  summaries       BankReconciliationSummary[]
  statements      BankStatement[]
  transactions    BankTransaction[]
}

model BankStatement {
  id             String            @id @default(cuid())
  bankAccountId  String
  importedAt     DateTime          @default(now())
  importedBy     String
  statementDate  DateTime
  sourceFileName String
  hash           String
  bankAccount    BankAccount       @relation(fields: [bankAccountId], references: [id])
  transactions   BankTransaction[]

  @@unique([bankAccountId, hash])
}

model BankTransaction {
  id            String                 @id @default(cuid())
  bankAccountId String
  statementId   String
  date          DateTime
  amount        Decimal
  matchedAmount Decimal                @default(0)
  reference     String?
  narration     String?
  status        BankTransactionStatus  @default(UNMATCHED)
  statement     BankStatement          @relation(fields: [statementId], references: [id])
  bankAccount   BankAccount            @relation(fields: [bankAccountId], references: [id])
  matches       BankTransactionMatch[]
}

model BankTransactionMatch {
  id                String          @id @default(cuid())
  bankTransactionId String
  customerPaymentId String?
  supplierPaymentId String?
  journalEntryId    String?
  confidence        MatchConfidence
  status            MatchStatus     @default(SUGGESTED)
  matchedAt         DateTime        @default(now())
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id])
}

model BankReconciliationSession {
  id            String                      @id @default(cuid())
  bankAccountId String
  startDate     DateTime
  endDate       DateTime
  status        ReconciliationSessionStatus @default(DRAFT)
  lockedAt      DateTime?
  lockedBy      String?
  bankAccount   BankAccount                 @relation(fields: [bankAccountId], references: [id])
}

model BankReconciliationSummary {
  id               String      @id @default(cuid())
  bankAccountId    String
  bookBalance      Decimal
  statementBalance Decimal
  matchedAmount    Decimal
  unmatchedAmount  Decimal
  difference       Decimal
  asOfDate         DateTime    @default(now())
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id])
}

model HsnSacCode {
  id                String  @id @default(cuid())
  businessId        String
  code              String
  description       String?
  defaultTaxGroupId String?

  @@index([businessId])
  @@map("hsn_sac_codes")
}

model TaxGroup {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  rates       TaxRate[]

  @@index([businessId])
  @@map("tax_groups")
}

model TaxRate {
  id          String   @id @default(cuid())
  taxGroupId  String
  taxType     TaxType
  ratePercent Decimal
  taxGroup    TaxGroup @relation(fields: [taxGroupId], references: [id])

  @@map("tax_rates")
}

model TaxSnapshot {
  id             String       @id @default(cuid())
  sourceType     String
  sourceId       String
  lineNumber     Int
  taxTreatment   TaxTreatment
  hsnSacCode     String?
  taxableAmount  Decimal
  cgstRate       Decimal      @default(0)
  cgstAmount     Decimal      @default(0)
  sgstRate       Decimal      @default(0)
  sgstAmount     Decimal      @default(0)
  igstRate       Decimal      @default(0)
  igstAmount     Decimal      @default(0)
  cessRate       Decimal      @default(0)
  cessAmount     Decimal      @default(0)
  totalTaxAmount Decimal      @default(0)
  createdAt      DateTime     @default(now())

  @@map("tax_snapshots")
}

model TaxPeriod {
  id         String          @id @default(cuid())
  businessId String
  startDate  DateTime
  endDate    DateTime
  status     TaxPeriodStatus @default(OPEN)

  @@index([businessId])
  @@map("tax_periods")
}

model Gstr1Summary {
  id           String  @id @default(cuid())
  businessId   String
  taxPeriod    String
  taxableValue Decimal @default(0)
  cgstAmount   Decimal @default(0)
  sgstAmount   Decimal @default(0)
  igstAmount   Decimal @default(0)
  cessAmount   Decimal @default(0)
  invoiceCount Int     @default(0)

  @@index([businessId, taxPeriod])
  @@map("gstr1_summaries")
}

model Gstr3BSummary {
  id                  String  @id @default(cuid())
  businessId          String
  taxPeriod           String
  outwardTaxableValue Decimal @default(0)
  outputCgst          Decimal @default(0)
  outputSgst          Decimal @default(0)
  outputIgst          Decimal @default(0)
  inputCgst           Decimal @default(0)
  inputSgst           Decimal @default(0)
  inputIgst           Decimal @default(0)
  netTaxLiability     Decimal @default(0)

  @@index([businessId, taxPeriod])
  @@map("gstr3b_summaries")
}

model Gstr2BReconciliationItem {
  id            String            @id @default(cuid())
  businessId    String
  supplierGstin String
  invoiceNumber String
  invoiceDate   DateTime
  expectedTax   Decimal
  actualTax     Decimal
  status        Gstr2BMatchStatus

  @@index([businessId])
  @@map("gstr2b_reconciliation_items")
}

model AssetCategory {
  id                               String       @id @default(cuid())
  businessId                       String
  name                             String
  description                      String?
  assetAccountId                   String
  accumulatedDepreciationAccountId String
  depreciationExpenseAccountId     String
  assets                           FixedAsset[]

  @@index([businessId])
  @@map("asset_categories")
}

model AssetLocation {
  id         String       @id @default(cuid())
  businessId String
  name       String
  address    String?
  assets     FixedAsset[]

  @@index([businessId])
  @@map("asset_locations")
}

model FixedAsset {
  id                 String                 @id @default(cuid())
  businessId         String
  categoryId         String
  locationId         String?
  assetCode          String
  name               String
  purchaseDate       DateTime?
  capitalizedAt      DateTime?
  inServiceDate      DateTime?
  cost               Decimal                @default(0)
  residualValue      Decimal                @default(0)
  usefulLifeMonths   Int                    @default(0)
  depreciationMethod String                 @default("SLM")
  status             FixedAssetStatus       @default(DRAFT)
  acquisition        AssetAcquisition?
  assignments        AssetAssignment[]
  disposal           AssetDisposal?
  schedules          DepreciationSchedule[]
  location           AssetLocation?         @relation(fields: [locationId], references: [id])
  category           AssetCategory          @relation(fields: [categoryId], references: [id])

  @@index([businessId])
  @@map("fixed_assets")
}

model AssetAssignment {
  id           String     @id @default(cuid())
  assetId      String
  assignedTo   String
  assignedDate DateTime
  returnedDate DateTime?
  asset        FixedAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("asset_assignments")
}

model AssetAcquisition {
  id              String                 @id @default(cuid())
  businessId      String
  description     String
  supplierId      String?
  supplierBillId  String?
  acquisitionDate DateTime
  cost            Decimal                @default(0)
  status          AssetAcquisitionStatus @default(PENDING)
  fixedAssetId    String?                @unique
  fixedAsset      FixedAsset?            @relation(fields: [fixedAssetId], references: [id])

  @@index([businessId])
  @@map("asset_acquisitions")
}

model DepreciationSchedule {
  id              String                     @id @default(cuid())
  assetId         String
  periodId        String
  scheduledDate   DateTime
  scheduledAmount Decimal                    @default(0)
  postedAmount    Decimal                    @default(0)
  postedAt        DateTime?
  postedBy        String?
  status          DepreciationScheduleStatus @default(PENDING)
  journalEntryId  String?
  asset           FixedAsset                 @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("depreciation_schedules")
}

model AssetDisposal {
  id             String            @id @default(cuid())
  assetId        String            @unique
  disposalDate   DateTime
  disposalType   AssetDisposalType
  proceedsAmount Decimal           @default(0)
  gainLossAmount Decimal           @default(0)
  journalEntryId String?
  asset          FixedAsset        @relation(fields: [assetId], references: [id])

  @@map("asset_disposals")
}

model CostCenter {
  id           String                @id @default(cuid())
  businessId   String
  code         String
  name         String
  type         CostCenterType
  parentId     String?
  path         String?
  level        Int                   @default(0)
  status       CostCenterStatus      @default(ACTIVE)
  parent       CostCenter?           @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children     CostCenter[]          @relation("CostCenterHierarchy")
  invoiceLines CustomerInvoiceLine[]
  journalLines JournalLine[]
  billLines    SupplierBillLine[]

  @@unique([businessId, code])
  @@map("cost_centers")
}

model CostCenterAssignment {
  id           String @id @default(cuid())
  costCenterId String
  entityType   String
  entityId     String

  @@map("cost_center_assignments")
}

model Budget {
  id            String       @id @default(cuid())
  businessId    String
  name          String
  version       Int          @default(1)
  startPeriodId String
  endPeriodId   String
  status        BudgetStatus @default(DRAFT)
  type          BudgetType   @default(OPERATING)
  lines         BudgetLine[]

  @@map("budgets")
}

model BudgetLine {
  id           String  @id @default(cuid())
  budgetId     String
  periodId     String
  accountId    String
  costCenterId String?
  amount       Decimal @default(0)
  budget       Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodId, accountId, costCenterId])
  @@map("budget_lines")
}

model DocumentAttachment {
  id         String             @id @default(cuid())
  businessId String
  tenantId   String
  sourceType DocumentSourceType
  sourceId   String
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String?
  version    Int                @default(1)
  storageUrl String
  previewUrl String?
  status     DocumentStatus     @default(ACTIVE)
  uploadedBy String
  uploadedAt DateTime           @default(now())

  @@index([businessId, sourceType, sourceId])
  @@map("document_attachment")
}

model ApprovalRequest {
  id           String             @id @default(cuid())
  businessId   String
  tenantId     String
  sourceType   ApprovalSourceType
  sourceId     String
  status       ApprovalStatus     @default(PENDING)
  entityHash   String
  snapshotJson String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  actions      ApprovalAction[]

  @@index([businessId, sourceType, sourceId])
  @@map("approval_request")
}

model ApprovalAction {
  id                String             @id @default(cuid())
  approvalRequestId String
  actionType        ApprovalActionType
  performedBy       String
  notes             String?
  createdAt         DateTime           @default(now())
  request           ApprovalRequest    @relation(fields: [approvalRequestId], references: [id])

  @@map("approval_action")
}

model ComplianceJob {
  id            String              @id @default(cuid())
  businessId    String
  tenantId      String
  type          ComplianceJobType
  status        ComplianceJobStatus @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?
  payload       Json
  correlationId String
  nextAttemptAt DateTime?
  createdAt     DateTime            @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([businessId])
  @@map("compliance_jobs")
}

model AuditEvent {
  id             String         @id @default(cuid())
  businessId     String
  tenantId       String
  entityType     String
  entityId       String
  eventType      AuditEventType
  correlationId  String
  performedBy    String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([businessId, entityType, entityId])
  @@index([correlationId])
  @@index([businessId, createdAt])
  @@map("audit_events")
}

model RecurringCommitment {
  id          String                  @id @default(cuid())
  businessId  String
  name        String
  amount      Decimal
  type        RecurringCommitmentType
  frequency   CommitmentFrequency
  nextDueDate DateTime
  category    CashFlowCategory
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?
  business    Business                @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("recurring_commitments")
}

