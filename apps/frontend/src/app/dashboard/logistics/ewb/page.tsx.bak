import { db } from "@/lib/db";
import { requireBusinessContext } from "@/lib/auth/context";
import { requirePermission } from "@/lib/auth/rbac";
import Link from "next/link";
import { Button } from "@/components/ui/button";

export default async function EWayBillsPage() {
  const { businessId, tenantId, userId } = await requireBusinessContext();
  await requirePermission(userId, tenantId, "logistics.read");

  const ewbs = await db.eWayBill.findMany({
    where: { businessId },
    include: { invoice: true },
    orderBy: { createdAt: "desc" }
  });

  const now = new Date();
  
  return (
    <div className="p-8 max-w-7xl mx-auto">
      <div className="flex justify-between items-center mb-8">
        <div>
          <h1 className="text-2xl font-bold text-slate-900">E-Way Bills</h1>
          <p className="text-slate-500 text-sm">GST compliance tracking</p>
        </div>
        <Link href="/dashboard/logistics">
          <Button variant="outline">Back</Button>
        </Link>
      </div>

      <div className="bg-white border rounded-xl shadow-sm overflow-hidden">
        <table className="w-full text-left text-sm">
          <thead className="bg-slate-50 text-slate-600 border-b">
            <tr>
              <th className="p-4 font-medium">EWB Number</th>
              <th className="p-4 font-medium">Source / Invoice</th>
              <th className="p-4 font-medium">Vehicle & Transporter</th>
              <th className="p-4 font-medium">Valid Until</th>
              <th className="p-4 font-medium">Status</th>
            </tr>
          </thead>
          <tbody className="divide-y text-slate-700">
            {ewbs.map((ewb) => {
              let validityColor = "text-slate-700";
              let timeRemaining = "";

              if (ewb.status === "GENERATED" && ewb.validUntil) {
                const msLeft = ewb.validUntil.getTime() - now.getTime();
                const hoursLeft = msLeft / (1000 * 60 * 60);

                if (hoursLeft < 0) {
                  validityColor = "text-red-600 font-medium";
                  timeRemaining = "(Expired)";
                } else if (hoursLeft < 24) {
                  validityColor = "text-amber-600 font-medium";
                  timeRemaining = \`(\${Math.floor(hoursLeft)}h left)\`;
                } else {
                  validityColor = "text-green-600";
                  timeRemaining = \`(\${Math.floor(hoursLeft/24)}d left)\`;
                }
              }

              return (
                <tr key={ewb.id} className="hover:bg-slate-50 transition-colors">
                  <td className="p-4 font-medium">{ewb.ewbNumber}</td>
                  <td className="p-4">
                    <span className="text-blue-600 font-medium">{ewb.invoice?.code || ewb.invoiceId}</span>
                    <div className="text-xs text-slate-500 mt-1">{ewb.generationSource.replace("_", " ")}</div>
                  </td>
                  <td className="p-4">
                    <div className="font-medium text-slate-800">{ewb.vehicleNumber || "Unassigned"}</div>
                    <div className="text-xs text-slate-500 mt-1">{ewb.transporterName || "Internal"}</div>
                  </td>
                  <td className="p-4">
                    <div className={validityColor}>
                      {ewb.validUntil ? ewb.validUntil.toLocaleString() : "-"}
                    </div>
                    {timeRemaining && (
                        <div className={\`text-xs mt-1 \${validityColor}\`}>{timeRemaining}</div>
                    )}
                  </td>
                  <td className="p-4">
                    <span className={\`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium \${
                      (ewb.status === "GENERATED" && !timeRemaining.includes("Expired")) ? "bg-green-100 text-green-700" :
                      ewb.status === "CANCELLED" ? "bg-red-100 text-red-700" :
                      (ewb.status === "EXPIRED" || timeRemaining.includes("Expired")) ? "bg-slate-200 text-slate-800" :
                      "bg-amber-100 text-amber-700"
                    }\`}>
                      {timeRemaining.includes("Expired") ? "EXPIRED" : ewb.status}
                    </span>
                  </td>
                </tr>
              );
            })}
            {ewbs.length === 0 && (
              <tr>
                <td colSpan={5} className="p-8 text-center text-slate-500">
                  No E-Way Bills found.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
